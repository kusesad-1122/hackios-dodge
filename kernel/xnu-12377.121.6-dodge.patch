+		uint32_t read = h->read_index, write = h->write_index;
+		uint32_t pending = (write % HFI_QUEUE_WORDS + HFI_QUEUE_WORDS - read % HFI_QUEUE_WORDS) % HFI_QUEUE_WORDS;
